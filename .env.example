# Dakota Analytics - Energy Data Pipeline
# ========================================
# Copy this file to .env before running:
#   cp .env.example .env
#
# Then edit .env with your actual API key.
# Get a free EIA API key at: https://www.eia.gov/opendata/register.php

# Required: Your EIA API Key
EIA_API_KEY=your_eia_api_key_here

# Synthetic API URL (Docker internal network)
API_URL=http://synthetic_api:8000

# Database path (inside container)
DATABASE_PATH=/database/energy_data.duckdb

# Dagster configuration
DAGSTER_HOME=/app/dagster_home

# dbt configuration
DBT_PROJECT_DIR=/dbt
DBT_PROFILES_DIR=/dbt
DBT_TARGET=dev
